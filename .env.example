# Google Generative AI / Gemini Configuration
GOOGLE_GEMINI_API_KEY=your-google-ai-studio-api-key-here
GEMINI_MODEL=gemini-2.0-flash

# Application Configuration
NODE_ENV=development
PORT=3100
LOG_LEVEL=info

# FHIR Server Configuration
FHIR_BASE_URL=https://hapi.fhir.org/baseR4
FHIR_TOKEN=your-fhir-bearer-token-here

# MCP Server Configuration
MCP_SERVER_NAME=healthguard
MCP_SERVER_VERSION=0.2.0

# Regulatory Configuration
IB_EXCEPTIONS_VERSION=2024
HIPAA_REFERENCE_DATE=2024-01-01

# Security Configuration
AUDIT_HASH_ALGORITHM=sha256
PHI_LOGGING_ENABLED=false
